	file = {:Users/gonzalo/McSCert/scc/ref/McSCert/A Software Certification Consortium and its Top 9 Hurdles (safecert08).pdf:pdf},
	issn = {1571-0661},
	journal = {Electronic Notes in Theoretical Computer Science},
	keywords = {formal methods,objectives,projects,scc,software certification consortium},
	number = {4},
	pages = {11--17},
	publisher = {Elsevier},
